# Application Settings
PROJECT_NAME=HealthEase
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# MongoDB Settings (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=healthease

# Security & Authentication
JWT_SECRET=healthease_super_secure_jwt_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Bootstrap Administrator (Initial admin setup)
ADMIN_NAME=HealthEase Admin
ADMIN_EMAIL=admin@healthease.com
ADMIN_PASSWORD=Admin@HealthEase2026

# Redis Settings (Caching & Rate Limiting)
# Local: redis://localhost:6379/0
# Optional: if Redis is unreachable, system automatically falls back gracefully
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CACHE_TTL_SECONDS=300

# RabbitMQ Settings (Background Notification Processing)
# Local: amqp://guest:guest@localhost:5672/
# Optional: if RabbitMQ is unreachable, notifications fall back to direct persistence
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=healthease_notifications

# Medical AI Chatbot (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
